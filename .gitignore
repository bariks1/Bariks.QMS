# SmartQMS – .gitignore

# ── Security: NEVER commit these files ────────────────────────────────────────
tenant.config.json
tenant.credentials.json
*.credentials.json
.clasp.json       # Contains scriptId — per-tenant, not shared

# ── Build outputs ─────────────────────────────────────────────────────────────
build/
dist/
out/
.cache/

# ── Node / npm ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ── Test / Coverage ───────────────────────────────────────────────────────────
.nyc_output/
coverage/

# ── IDE and editor files ──────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.swp
*.swo

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor scratch ────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.log
*~
